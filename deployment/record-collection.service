[Unit]
Description=Record Collection
After=network.target

[Service]
Type=simple
User=vinyl
Group=vinyl
WorkingDirectory=/opt/record-collection
EnvironmentFile=/etc/record-collection.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/record-collection/venv/bin/gunicorn --bind 0.0.0.0:5002 --workers 1 --threads 4 --timeout 120 --access-logfile - --error-logfile - server:app
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# SQLite journal/WAL files must be creatable alongside records.db.
ReadWritePaths=/opt/record-collection

[Install]
WantedBy=multi-user.target
